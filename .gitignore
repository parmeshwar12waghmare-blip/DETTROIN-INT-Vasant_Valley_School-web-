# Root-level gitignore for Vasant Valley School monorepo

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/

# ── Build Outputs ─────────────────────────────────────────────────────────────
frontend/dist/
frontend/dist-ssr/
*.local

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
backend/.env

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS Files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
