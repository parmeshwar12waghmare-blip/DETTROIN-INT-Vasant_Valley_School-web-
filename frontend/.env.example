# ─── FRONTEND ENVIRONMENT VARIABLES ─────────────────────────────────────────
# Copy this file to .env.local for local development.
# In Vercel, set these in: Project Settings → Environment Variables

# Backend API URL (Render deployment URL — NO trailing slash, NO /api suffix)
VITE_API_URL=https://your-render-backend-url.onrender.com/api

# Firebase Configuration
# Get these from: Firebase Console → Project Settings → Your Apps → SDK Config
VITE_FIREBASE_AUTH_DOMAIN=vasant-valley-school.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vasant-valley-school
VITE_FIREBASE_STORAGE_BUCKET=vasant-valley-school.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
