# ─── BACKEND ENVIRONMENT VARIABLES ───────────────────────────────────────────
# Copy this file to .env for local development.
# In Render, set these in: Service Dashboard → Environment Variables

# MongoDB Atlas connection string (required for production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vasant_valley_school?retryWrites=true&w=majority

# Server port (Render uses 10000 by default)
PORT=5000

# Node environment
NODE_ENV=production

# CORS: Comma-separated frontend URLs allowed to make API requests
# Set this to your Vercel deployment URL in production
ALLOWED_ORIGIN=https://your-frontend.vercel.app

# Instagram Graph API (optional - mock data will be used if not set)
# INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here
# INSTAGRAM_USER_ID=your_instagram_user_id_here
